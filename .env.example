# Copy to .env.local for local dev, or set these in Vercel → Settings → Environment Variables.
# Every key is optional: without it the matching feature falls back gracefully.

# Ask the Engine (chat). Claude is used when set; otherwise Gemini.
ANTHROPIC_API_KEY=
ENGINE_MODEL=
# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=

# Contact form (Transmit). Without RESEND_API_KEY the form opens the visitor's mail app.
RESEND_API_KEY=
# e.g. "Data Foundry <hello@yourdomain.com>" once a domain is verified in Resend
TRANSMIT_FROM=

# Public origin for canonical URLs, sitemap and social cards. Defaults to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=
# Live data feed (server-sent events). Defaults to Wikimedia's recent-changes stream.
NEXT_PUBLIC_LIVE_FEED_URL=
